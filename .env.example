# =============================================================================
# AutoLimpio — Environment Variables
# Copy this file to .env.local and fill in all values
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# Get these from: https://supabase.com → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# The public URL of your deployed app (used for portal links in SMS)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Supabase email redirect (only needed in development)
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Twilio (required for SMS)
# Get these from: https://console.twilio.com
# For Venezuela: use a US/international number with international calling enabled
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# -----------------------------------------------------------------------------
# Vercel Cron Secret (auto-set by Vercel in production)
# For local testing: set any random string here
# In production: Vercel injects this automatically for cron routes
# -----------------------------------------------------------------------------
CRON_SECRET=your-random-secret-here
